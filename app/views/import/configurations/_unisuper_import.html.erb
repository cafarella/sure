<%# locals: (import:) %>

<% accounts = Current.family.accounts.writable_by(Current.user).where(accountable_type: "Investment", currency: UnisuperImport::CURRENCY).alphabetically %>

<%= render DS::Alert.new(message: t(".intro"), variant: :info) %>

<%= styled_form_with model: @import, url: import_configuration_path(@import), scope: :import, method: :patch, class: "space-y-4" do |form| %>
  <%= form.select :account_id,
                  accounts.map { |account| [ account.name, account.id ] },
                  { include_blank: t(".select_account"), label: t(".account"), help_text: t(".account_help") },
                  required: true,
                  disabled: import.complete? %>

  <div class="space-y-2">
    <p class="text-sm text-primary"><%= t(".allocation") %></p>
    <p class="text-xs text-secondary"><%= t(".allocation_help") %></p>

    <%= form.fields_for :unisuper_allocation do |allocation| %>
      <% import.allocation_choices.each do |option| %>
        <%= allocation.number_field import.allocation_key(option),
                                    value: import.unisuper_allocation[option]&.to_s("F"),
                                    label: option,
                                    min: 0,
                                    max: 100,
                                    step: "any",
                                    disabled: import.complete? %>
      <% end %>
    <% end %>
  </div>

  <%= form.submit t(".apply_configuration"), disabled: import.complete? %>
<% end %>
